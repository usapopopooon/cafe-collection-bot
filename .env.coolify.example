# Keep disabled for the first deploy; enable after level-bot's Cafe API is ready.
BOT_ENABLED=false
DISCORD_TOKEN=

# level-bot APIの公開またはCoolify内部URLと、
# level-bot側のCAFE_COLLECTION_API_TOKENと同じ専用キー。
LEVEL_BOT_API_BASE_URL=https://level-bot.example.com
LEVEL_BOT_API_TOKEN=replace-with-the-same-long-random-token

# chill-cafe-siteがlevel-botとの通信に使う公開用Bearer JWTと同じ値。
EXTERNAL_API_KEY=replace-with-the-level-bot-public-site-token
CORS_ORIGINS=https://chill-cafe.site

LOG_LEVEL=INFO
BOT_MEMORY_LIMIT=320m
BOT_CPUS=0.75
API_MEMORY_LIMIT=192m
API_CPUS=0.50
